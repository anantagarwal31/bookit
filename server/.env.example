# Copy this file to .env before running the server locally
PORT=4000
NODE_ENV=development

# PostgreSQL connection string used by the app AND by the migration tool
DATABASE_URL=postgresql://bookit:bookit@localhost:5432/bookit

# Secret used to sign the JWT stored in the auth cookie
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origins allowed to call this API (comma separated)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# --- only needed when the API and the frontend are on DIFFERENT domains ---
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true